{
  "name": "assay-design",
  "version": "0.1.0",
  "description": "Declarative design-system contracts verified by AVP across code, Storybook, and Figma.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "sideEffects": false,
  "engines": { "node": ">=24" },
  "repository": { "type": "git", "url": "git+https://github.com/lucasrgt/assay-design.git" },
  "bin": { "assay-design": "dist/cli.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./mcp": { "types": "./dist/mcp.d.ts", "import": "./dist/mcp.js" },
    "./storybook": "./dist/storybook/preset.js",
    "./storybook/manager": "./dist/storybook/manager.js",
    "./storybook/preview": "./dist/storybook/preview.js",
    "./package.json": "./package.json"
  },
  "files": ["dist", "figma", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:package": "npm run build && node tools/package-smoke.mjs",
    "harness": "node tools/harness.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:package && npm run harness",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "avp-assay": "^0.4.0",
    "smol-toml": "^1.7.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": { "react": ">=18", "storybook": "^10.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true }, "storybook": { "optional": true } },
  "overrides": { "esbuild": "^0.28.1" },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/plugin-typings": "^1.119.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.2",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "storybook": "^10.5.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
