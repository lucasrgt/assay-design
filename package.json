{
  "name": "assay-design",
  "version": "0.6.2",
  "description": "Cross-framework linter for design-system, Atomic Design, screen, and multi-app consistency.",
  "type": "module",
  "license": "MIT",
  "author": "Lucas Tinoco",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasrgt/assay-design.git"
  },
  "bin": {
    "assay-design": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./storybook": "./dist/storybook/preset.js",
    "./storybook/manager": "./dist/storybook/manager.js",
    "./storybook/preview": "./dist/storybook/preview.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "figma",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:package": "npm run build && node tools/package-smoke.mjs",
    "harness": "node tools/harness.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "storybook": "npm run build && storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "storybook:build": "npm run build && storybook build",
    "storybook:serve": "node tools/serve-storybook.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:package && npm run harness",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "avp-assay": "^0.4.0",
    "smol-toml": "^1.7.1",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "storybook": "^10.0.0",
    "storybook-addon-pseudo-states": "^10.5.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "storybook": {
      "optional": true
    },
    "storybook-addon-pseudo-states": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/plugin-typings": "^1.119.0",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "^10.5.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.2",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-native-web": "^0.21.2",
    "storybook": "^10.5.5",
    "storybook-addon-pseudo-states": "^10.5.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
